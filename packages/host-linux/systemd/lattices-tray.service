# Use `bun packages/host-linux/scripts/install-tray.ts` to render the checkout
# and Bun paths, link both units, and enable this tray in the user session.
[Unit]
Description=Lattices tray
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/env bun %h/dev/projects/lattices/packages/host-linux/src/main.ts tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
