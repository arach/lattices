          "text": "Action demo notes\n\n- Native capture is stable\n- Notes now has a typing scenario\n- Shortcut overlays make the flow feel deliberate\n- Composition polish is the next pass",
          "delayMs": 55,
          "style": "notes"
        },
        "cue": {
          "kind": "chapter",
          "text": "Type the note live",
          "atMs": 400
        }
      }
    ]
  }
