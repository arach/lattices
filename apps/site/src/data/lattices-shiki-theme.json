{
  "name": "lattices-ink",
  "type": "dark",
  "colors": {
    "editor.background": "#121615",
    "editor.foreground": "#E4E2DC",
    "editorLineNumber.foreground": "#5C605E",
    "editor.selectionBackground": "#3A2A24"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6E726F"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#F08A68"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D8C49E"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E9B48F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F4F2EC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type.swift"
      ],
      "settings": {
        "foreground": "#B9C6CC"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "entity.name.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#D6D4CE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8A8E8B"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#F4F2EC"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D6D4CE"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#F4F2EC"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF7A7A"
      }
    }
  ]
}
