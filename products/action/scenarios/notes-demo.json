{
  "id": "notes-demo",
  "title": "Notes Guided Capture Demo",
  "targetApp": {
    "name": "Notes",
    "bundleId": "com.apple.Notes"
  },
  "run": {
    "initialActionDelayMs": 1200,
    "actionCadenceMs": 1800
  },
  "stage": {
    "backdrop": "matte",
    "viewport": {
      "id": "main",
      "bounds": {
        "x": 180,
