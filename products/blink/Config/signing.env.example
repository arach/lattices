# Copy to Config/signing.env and fill in — then: source Config/signing.env
# before running tools/release/*.sh. All are optional if the scripts can
# auto-detect your identity and you've stored a notarytool profile.

# Developer ID Application identity (SHA-1 hash or full name). Auto-detected from
# your keychain if unset.
export BLINK_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# notarytool keychain profile name (created once via `xcrun notarytool
# store-credentials <name> --key-id … --issuer … --key AuthKey_….p8`).
export BLINK_NOTARY_PROFILE="notarytool"

# App build needs the private Hudson dependency. Either keep a ../hudson checkout
# (default), or resolve over git with a read token:
# export BLINK_HUDSON_SOURCE="git"
# export HUDSON_READ_TOKEN="ghp_…"

# GitHub release target (defaults shown).
# export BLINK_RELEASE_REPO="arach/blink"
# export BLINK_RELEASE_TARGET="main"
