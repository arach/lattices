+
+    public func enqueue(
+        _ item: HudSpeechQueueItem,
+        priority: HudSpeechQueuePriority = .normal,
+        interrupt: Bool = false,
+        autoplay: Bool? = nil
+    ) throws
+
+    public func pause()
+    public func resume() throws
+    public func togglePlayback() throws
+    public func stop()
+    public func skip() throws
